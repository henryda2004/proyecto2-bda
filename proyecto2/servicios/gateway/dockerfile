#Construye la imagen del gateway utilizando Python 3.12.
#Instala las dependencias, copia el codigo e inicia el servidor
#con Uvicorn en el puerto 8000 dentro del contenedor.



FROM python:3.12-slim

WORKDIR /app

COPY requerimientos.txt .
RUN pip install --no-cache-dir -r requerimientos.txt

COPY main.py .

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]